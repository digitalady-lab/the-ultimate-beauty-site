{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/shape",
      "destination": "https://shape.theultimatebeauty.net",
      "permanent": true
    },
    {
      "source": "/invitation",
      "destination": "https://invitation.theultimatebeauty.net",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
